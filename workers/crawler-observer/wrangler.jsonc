{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website-crawler-observer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "me.itheheda.online/robots.txt*", "zone_name": "itheheda.online" },
    { "pattern": "me.itheheda.online/_crawler-observer/v1/*", "zone_name": "itheheda.online" }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "personal-website-crawler-observer", "database_id": "0fc1d826-c09c-4d38-b499-2b6ec5a02ede", "migrations_dir": "migrations" }],
  "secrets": {
    "required": ["OPEN_GEO_SELF_TEST_SECRET", "OBSERVER_READ_SECRET"]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
